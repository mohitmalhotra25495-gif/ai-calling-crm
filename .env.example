# Database (PostgreSQL - use Neon, Supabase, AWS RDS etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Secret (change this to a random string)
JWT_SECRET=your-secret-key-change-this-in-production

# ─── Global Tabbly credentials (OPTIONAL but recommended) ───
# Set these once and ALL users/customers can make AI calls
# without configuring anything themselves.
# Get these from your Tabbly dashboard (https://tabbly.io)
TABBLY_API_KEY=your_tabbly_api_key
TABBLY_AGENT_ID=123
TABBLY_ORGANIZATION_ID=your_org_id
# TABBLY_BASE_URL=https://www.tabbly.io/dashboard/agents/endpoints
